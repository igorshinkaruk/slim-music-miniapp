# Brand
BRAND_NAME=Slim Music

# Telegram Bot (from @BotFather / MUSIC_BOT_TOKEN)
BOT_TOKEN=
# Comma-separated Telegram user IDs (admin / editor)
ADMIN_IDS=8764474734

# Public HTTPS URL of the Mini App (required for Telegram WebApp button)
WEBAPP_URL=https://your-domain.example/

# Backend
HOST=0.0.0.0
PORT=8001

# Production (Render): set DATABASE_URL to Internal Postgres URL.
# Local DEV: leave empty → SQLite via DB_PATH.
DATABASE_URL=
DB_PATH=./data/slim_music.db
MEDIA_DIR=./data/media

# Local browser testing without Telegram
DEV_BYPASS=1
DEV_USER_ID=8764474734
DEV_USER_NAME=Slim

# Audio limits
MAX_AUDIO_BYTES=52428800
# YouTube via yt-dlp (may violate YT ToS — personal/demo only)
YOUTUBE_ENABLED=1
